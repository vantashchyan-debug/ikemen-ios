+	muted   bool
+}
+
+func (bgv *bgVideo) Open(filename string, volume int, sm BgVideoScaleMode, sf BgVideoScaleFilter, loop bool) error {
+	// Succeed silently: the background simply renders nothing (texture stays nil).
+	return nil
